# Backend Environment Variables
# Copy this file to `.env` and fill in all values before running in production.

# ── Core ──────────────────────────────────────────────────────────────────────
# Flask secret key (used to sign sessions). Change in production!
SECRET_KEY=change-me-in-production

# ── AI ────────────────────────────────────────────────────────────────────────
# Google Gemini API key for AI-powered entity extraction and trip planning.
# Get it at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Google Places API key for location searching and geocoding.
# Get it at: https://console.cloud.google.com/
PLACES_API_KEY=

# ── GDS (Flight & Hotel Pricing: Duffel + RapidAPI Hotels.com) ─────────────────────────
# Duffel API is used for real live flight data and checkout links.
# Get it at: https://duffel.com/
DUFFEL_API_KEY=

# RapidAPI is used for real live hotel data via Hotels.com.
# Register for a free account at: https://rapidapi.com/
# Subscribe to a Hotels.com provider (e.g. hotels-com-provider)
RAPIDAPI_KEY=
RAPIDAPI_HOST=hotels-com-provider.p.rapidapi.com

# ── Firebase / Firestore ──────────────────────────────────────────────────────
# Path to your Firebase service account JSON file.
# Download from Firebase Console → Project Settings → Service Accounts.
# Required for Firestore session persistence and Firebase Auth token verification.
GOOGLE_APPLICATION_CREDENTIALS=

# ── Redis (WebSocket scaling + GDS caching) ───────────────────────────────────
# Redis connection URL. Supports: redis://, rediss:// (TLS), redis+sentinel://
# Leave blank to use in-process in-memory caching (not suitable for multi-instance).
# Local:  redis://localhost:6379/0
# Upstash: rediss://:password@host:port
REDIS_URL=

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Example: https://yourdomain.com,https://www.yourdomain.com
# Set to * for local development only.
ALLOWED_ORIGINS=*

# Set to true to bypass Firebase JWT checks (LOCAL DEV ONLY — never in prod).
AUTH_DISABLED=true

# ── Server ────────────────────────────────────────────────────────────────────
# Port the server listens on.
PORT=8000

# Gunicorn: number of gevent workers (default 1, handles 1000+ concurrent sockets).
GUNICORN_WORKERS=1
GUNICORN_CONNECTIONS=1000

# Log level: debug | info | warning | error
LOG_LEVEL=info

# ── SocketIO async mode ───────────────────────────────────────────────────────
# Use 'gevent' in production (requires gunicorn + gevent-websocket).
# Use 'threading' for local development with python -m backend.app
SOCKETIO_ASYNC_MODE=threading

# ── Windfall recovery pipeline ────────────────────────────────────────────────
# Replay a captured run instead of calling live APIs. Protects judging day from
# rate limits and network failure, and conserves Gemini quota in development.
# The live path stays fully functional; the UI labels replay mode visibly.
# NOTE: fixtures replace INFERENCE, not DELIVERY -- email still sends.
WINDFALL_FIXTURES=0

# Mock LLM responses for plumbing work that does not need inference.
MOCK_LLM=false

# ── Notification delivery ─────────────────────────────────────────────────────
# Master switch. Set false for a judging environment with no outbound SMTP:
# the whole approval flow still runs and reports "suppressed", never "sent".
SEND_ENABLED=true

# EVERY send routes here, whatever the traveler's stored address. Seeded
# travelers are synthetic and their addresses are invented; delivering to them
# would bounce and damage the sending domain's reputation. Use an inbox you
# control -- Gmail with an app password, or Mailtrap for zero deliverability
# risk while developing.
DEMO_RECIPIENT=

# SMTP transport. Gmail: smtp.gmail.com / 587 / an App Password (NOT your
# account password). Mailtrap: sandbox.smtp.mailtrap.io / 2525.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
